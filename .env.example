# Copy to .env (git-ignored) and fill in. Never commit real keys.
STATION_HOST=127.0.0.1      # ESP32 IP on the hotspot, or 127.0.0.1 for the software station
STATION_PORT=5020           # 502 for the ESP32, 5020 for the software station
GATEWAY_PORT=1502
AGENT_MODEL=anthropic:claude-haiku-5-5   # "provider:model"; empty = templated operator texts only
ANTHROPIC_API_KEY=          # the key for that provider
SPEND_CEILING_USD=5         # model spend (ledger in the database); past it, templated texts only
DATABASE_URL=sqlite:///backflow.db
OPERATOR_CHANNEL=dashboard  # dashboard | photon
PHYSICS_TIMEOUT_S=0.25      # seconds the physics check may take before the write is held
DEMO_CLOCK=                # optional "HH:MM" or ISO time that replaces the wall clock in policy checks (demo: 03:00)
